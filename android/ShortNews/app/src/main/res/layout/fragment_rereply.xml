<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/commentWrite"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/edit_text_background"
        android:ems="10"
        android:hint="댓글을 작성해주세요"
        android:inputType="text"
        android:padding="8dp"
        android:paddingEnd="65dp"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="TouchTargetSizeCheck" />

    <android.widget.Button
        android:id="@+id/commentWriteButton"
        android:layout_width="60dp"
        android:layout_height="35dp"
        android:background="@drawable/comment_write_button"
        android:backgroundTint="#FFFFFF"
        android:paddingHorizontal="0dp"
        android:paddingVertical="0dp"
        android:text="등록"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/commentWrite"
        app:layout_constraintEnd_toEndOf="@+id/commentWrite"
        app:layout_constraintHorizontal_bias="0.99"
        app:layout_constraintStart_toStartOf="@+id/commentWrite"
        app:layout_constraintTop_toTopOf="@+id/commentWrite"
        tools:ignore="TouchTargetSizeCheck" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/commentWrite"
        app:layout_constraintStart_toStartOf="@+id/commentWrite"
        app:layout_constraintTop_toBottomOf="@+id/commentWrite" />


</androidx.constraintlayout.widget.ConstraintLayout>