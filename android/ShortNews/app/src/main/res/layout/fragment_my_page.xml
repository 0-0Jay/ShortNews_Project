<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.news.NavBarFragment">

    <include
        android:id="@+id/include"
        layout="@layout/fragment_nav_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp"
            tools:ignore="DuplicateClickableBoundsCheck">

            <TextView
                android:id="@+id/userInfo"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:background="@drawable/button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal|center_vertical"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="회원 정보"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp"
            tools:ignore="DuplicateClickableBoundsCheck">

            <TextView
                android:id="@+id/myActivity"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:background="@drawable/button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal|center_vertical"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="나의 활동"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp"
            tools:ignore="DuplicateClickableBoundsCheck">

            <TextView
                android:id="@+id/bookmark"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:background="@drawable/button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal|center_vertical"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="북마크"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:textAlignment="center"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp"
            tools:ignore="DuplicateClickableBoundsCheck">

            <TextView
                android:id="@+id/logout"
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:background="@drawable/button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal|center_vertical"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="로그아웃"
                android:textColor="#FF4141"
                android:textSize="16sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>


    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        tools:ignore="SpeakableTextPresentCheck">

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/userInfoView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:paddingBottom="10dp"
                android:visibility="visible"
                app:cardCornerRadius="15dp"
                app:cardElevation="8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:backgroundTint="@color/white">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profileImg"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_marginTop="20dp"
                        android:src="@drawable/profile"
                        app:civ_border_overlay="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view" />

                    <android.widget.Button
                        android:id="@+id/changeProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="28dp"
                        android:layout_marginEnd="-60dp"
                        android:background="@drawable/button_white"
                        android:text="사진 변경"
                        app:layout_constraintEnd_toStartOf="@+id/profileImg"
                        app:layout_constraintTop_toBottomOf="@+id/profileImg"
                        tools:ignore="TouchTargetSizeCheck" />

                    <android.widget.Button
                        android:id="@+id/defaultProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="-60dp"
                        android:background="@drawable/button_white"
                        android:text="기본 이미지"
                        app:layout_constraintStart_toEndOf="@+id/profileImg"
                        app:layout_constraintTop_toTopOf="@+id/changeProfile"
                        tools:ignore="TouchTargetSizeCheck" />

                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="회원 정보 수정"
                        android:textColor="#7B7B7B"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/view"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="10dp"
                        android:background="#767676"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView5"
                        tools:ignore="MissingConstraints" />

                    <TextView
                        android:id="@+id/textView7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="40dp"
                        android:text="닉네임"
                        android:textAllCaps="false"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/changeProfile" />

                    <EditText
                        android:id="@+id/changeNicknameText"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="50dp"
                        android:background="@drawable/outline"
                        android:ems="10"
                        android:enabled="false"
                        android:hint="닉네임"
                        android:inputType="text"
                        android:paddingLeft="8dp"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@+id/textView7"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/changeProfile"
                        app:layout_constraintTop_toTopOf="@+id/textView7"
                        tools:ignore="TouchTargetSizeCheck" />

                    <ImageButton
                        android:id="@+id/changeNicknameBtn"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="10dp"
                        android:backgroundTint="@color/white"
                        android:padding="0dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/edit"
                        app:layout_constraintBottom_toBottomOf="@+id/changeNicknameText"
                        app:layout_constraintStart_toEndOf="@+id/changeNicknameText"
                        app:layout_constraintTop_toTopOf="@+id/changeNicknameText"
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />


                    <TextView
                        android:id="@+id/textView8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:text="전화번호"
                        android:textAllCaps="false"
                        app:layout_constraintEnd_toEndOf="@+id/textView7"
                        app:layout_constraintTop_toBottomOf="@+id/textView7" />

                    <EditText
                        android:id="@+id/changePhoneText"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:background="@drawable/outline"
                        android:ems="10"
                        android:enabled="false"
                        android:hint="전화번호"
                        android:inputType="phone"
                        android:paddingLeft="8dp"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="@+id/textView8"
                        app:layout_constraintEnd_toEndOf="@+id/changeNicknameText"
                        app:layout_constraintStart_toStartOf="@+id/changeNicknameText"
                        app:layout_constraintTop_toTopOf="@+id/textView8"
                        tools:ignore="TouchTargetSizeCheck" />

                    <ImageButton
                        android:id="@+id/changePhoneBtn"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:backgroundTint="@color/white"
                        android:padding="0dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/edit"
                        app:layout_constraintBottom_toBottomOf="@+id/changePhoneText"
                        app:layout_constraintStart_toStartOf="@+id/changeNicknameBtn"
                        app:layout_constraintTop_toTopOf="@+id/changePhoneText"
                        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                    <TextView
                        android:id="@+id/pw"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:text="비밀번호"
                        android:textAllCaps="false"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="@+id/textView8"
                        app:layout_constraintTop_toBottomOf="@+id/textView8" />

                    <android.widget.Button
                        android:id="@+id/changePwBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:background="@drawable/button_white"
                        android:padding="5dp"
                        android:text="비밀번호 변경"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="@+id/pw"
                        app:layout_constraintStart_toStartOf="@+id/changePhoneText"
                        app:layout_constraintTop_toTopOf="@+id/pw"
                        tools:ignore="TouchTargetSizeCheck" />

                    <TextView
                        android:id="@+id/textView3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:text="선호 카테고리 수정"
                        android:textColor="#7B7B7B"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/changePwBtn" />

                    <View
                        android:id="@+id/view2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="10dp"
                        android:background="#767676"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView3"
                        tools:ignore="MissingConstraints" />

                    <LinearLayout
                        android:id="@+id/linearLayout2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view2">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginBottom="10dp"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/category_100"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="10dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:backgroundTint="@color/background_color"
                                android:padding="5dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/category_politics"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/textView"
                                tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />

                            <ImageButton
                                android:id="@+id/category_101"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="10dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:backgroundTint="@color/background_color"
                                android:padding="5dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/category_economy"
                                app:layout_constraintStart_toEndOf="@+id/category_100"
                                app:layout_constraintTop_toTopOf="@+id/category_100"
                                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                            <ImageButton
                                android:id="@+id/category_102"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="10dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:backgroundTint="@color/background_color"
                                android:padding="5dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/category_society"
                                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"
                                tools:layout_editor_absoluteX="227dp"
                                tools:layout_editor_absoluteY="146dp" />

                            <ImageButton
                                android:id="@+id/category_103"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="10dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:backgroundTint="@color/background_color"
                                android:padding="5dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/category_culture"
                                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"
                                tools:layout_editor_absoluteX="88dp"
                                tools:layout_editor_absoluteY="381dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/category_104"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:backgroundTint="@color/background_color"
                                android:padding="5dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/category_world"
                                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"
                                tools:layout_editor_absoluteX="63dp"
                                tools:layout_editor_absoluteY="492dp" />

                            <ImageButton
                                android:id="@+id/category_105"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:backgroundTint="@color/background_color"
                                android:padding="5dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/category_it"
                                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"
                                tools:layout_editor_absoluteX="265dp"
                                tools:layout_editor_absoluteY="209dp" />

                            <ImageButton
                                android:id="@+id/category_106"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:backgroundTint="@color/background_color"
                                android:padding="5dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/category_entertainment"
                                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"
                                tools:layout_editor_absoluteX="118dp"
                                tools:layout_editor_absoluteY="529dp" />

                            <ImageButton
                                android:id="@+id/category_107"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:backgroundTint="@color/background_color"
                                android:padding="5dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/category_sports"
                                tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck"
                                tools:layout_editor_absoluteX="296dp"
                                tools:layout_editor_absoluteY="652dp" />

                        </LinearLayout>

                    </LinearLayout>

                    <android.widget.Button
                        android:id="@+id/changeCategoryBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/button_sky"
                        android:backgroundTint="@color/login_button"
                        android:text="저장"
                        android:textColor="@color/white"
                        app:cornerRadius="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
                        tools:ignore="TouchTargetSizeCheck" />

                    <TextView
                        android:id="@+id/textView10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:text="TTS 수정"
                        android:textColor="#7B7B7B"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/changeCategoryBtn" />

                    <View
                        android:id="@+id/view3"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="10dp"
                        android:background="#767676"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView10"
                        tools:ignore="MissingConstraints" />

                    <TextView
                        android:id="@+id/textView11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="성별"
                        app:layout_constraintBottom_toBottomOf="@+id/ttsModel"
                        app:layout_constraintEnd_toEndOf="@+id/pw"
                        app:layout_constraintTop_toTopOf="@+id/ttsModel" />

                    <TextView
                        android:id="@+id/textView12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:text="속도"
                        app:layout_constraintEnd_toEndOf="@+id/textView11"
                        app:layout_constraintTop_toBottomOf="@+id/textView11" />

                    <RadioGroup
                        android:id="@+id/ttsModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="@+id/changePwBtn"
                        app:layout_constraintTop_toBottomOf="@+id/view3">

                        <RadioButton
                            android:id="@+id/ttsMale"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:background="@drawable/radio_button_selector"
                            android:button="@null"
                            android:checked="true"
                            android:text="남성"
                            android:textAlignment="center"
                            android:textColor="@drawable/radio_button_selector_text"
                            tools:ignore="TouchTargetSizeCheck" />

                        <RadioButton
                            android:id="@+id/ttsFemale"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginLeft="10dp"
                            android:background="@drawable/radio_button_selector"
                            android:button="@null"
                            android:text="여성"
                            android:textAlignment="center"
                            android:textColor="@drawable/radio_button_selector_text"
                            tools:ignore="TouchTargetSizeCheck" />
                    </RadioGroup>

                    <RadioGroup
                        android:id="@+id/ttsSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="@+id/textView12"
                        app:layout_constraintStart_toStartOf="@+id/ttsModel"
                        app:layout_constraintTop_toTopOf="@+id/textView12">

                        <RadioButton
                            android:id="@+id/ttsSlow"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:background="@drawable/radio_button_selector"
                            android:button="@null"
                            android:text="느림"
                            android:textAlignment="center"
                            android:textColor="@drawable/radio_button_selector_text"
                            tools:ignore="TouchTargetSizeCheck" />

                        <RadioButton
                            android:id="@+id/ttsNomal"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginLeft="10dp"
                            android:background="@drawable/radio_button_selector"
                            android:button="@null"
                            android:text="보통"
                            android:textAlignment="center"
                            android:textColor="@drawable/radio_button_selector_text"
                            tools:ignore="TouchTargetSizeCheck" />

                        <RadioButton
                            android:id="@+id/ttsFast"
                            android:layout_width="match_parent"
                            android:layout_height="30dp"
                            android:layout_marginLeft="10dp"
                            android:background="@drawable/radio_button_selector"
                            android:button="@null"
                            android:text="빠름"
                            android:textAlignment="center"
                            android:textColor="@drawable/radio_button_selector_text"
                            tools:ignore="TouchTargetSizeCheck" />
                    </RadioGroup>

                    <android.widget.Button
                        android:id="@+id/changeTTSBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/button_sky"
                        android:backgroundTint="@color/login_button"
                        android:text="저장"
                        android:textColor="@color/white"
                        app:cornerRadius="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ttsSpeed"
                        tools:ignore="TouchTargetSizeCheck" />

                    <View
                        android:id="@+id/view4"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_centerInParent="true"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="50dp"
                        android:background="#767676"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/changeTTSBtn"
                        tools:ignore="MissingConstraints" />

                    <android.widget.Button
                        android:id="@+id/delete"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/button_sky"
                        android:backgroundTint="#FF2C2C"
                        android:text="회원탈퇴"
                        android:textColor="@color/white"
                        app:cornerRadius="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view4"
                        tools:ignore="TouchTargetSizeCheck" />


                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/myActivityView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:visibility="gone"
                app:cardCornerRadius="15dp"
                app:cardElevation="8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:backgroundTint="@color/white">

                    <LinearLayout
                        android:id="@+id/linearLayout3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="15dp"
                            app:cardElevation="8dp"
                            tools:ignore="DuplicateClickableBoundsCheck,TouchTargetSizeCheck">

                            <TextView
                                android:id="@+id/likeActivity"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/button_selector"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal|center_vertical"
                                android:minWidth="48dp"
                                android:minHeight="48dp"
                                android:text="좋아요"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="15dp"
                            app:cardElevation="8dp"
                            tools:ignore="DuplicateClickableBoundsCheck,TouchTargetSizeCheck">

                            <TextView
                                android:id="@+id/dislikeActivity"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/button_selector"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal|center_vertical"
                                android:minWidth="48dp"
                                android:minHeight="48dp"
                                android:text="싫어요"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="10dp"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="15dp"
                            app:cardElevation="8dp"
                            tools:ignore="DuplicateClickableBoundsCheck,TouchTargetSizeCheck">

                            <TextView
                                android:id="@+id/replyActivity"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/button_selector"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal|center_vertical"
                                android:minWidth="48dp"
                                android:minHeight="48dp"
                                android:text="댓글"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/sortNew"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:visibility="visible"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="8dp"
                        app:layout_constraintEnd_toStartOf="@+id/sortOld"
                        app:layout_constraintTop_toTopOf="@+id/sortOld"
                        tools:ignore="DuplicateClickableBoundsCheck,TouchTargetSizeCheck">

                        <TextView
                            android:id="@+id/newText"
                            android:layout_width="70dp"
                            android:layout_height="30dp"
                            android:background="@drawable/button_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal|center_vertical"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:text="최신순"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="visible" />
                    </androidx.cardview.widget.CardView>


                    <androidx.cardview.widget.CardView
                        android:id="@+id/sortOld"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:foregroundGravity="center_horizontal"
                        android:visibility="visible"
                        app:cardCornerRadius="15dp"
                        app:cardElevation="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/linearLayout3"
                        tools:ignore="DuplicateClickableBoundsCheck,TouchTargetSizeCheck">

                        <TextView
                            android:id="@+id/oldText"
                            android:layout_width="70dp"
                            android:layout_height="30dp"
                            android:background="@drawable/button_selector"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal|center_vertical"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:text="오래된 순"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="visible" />
                    </androidx.cardview.widget.CardView>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/RecyclerView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/sortNew" />


                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.cardview.widget.CardView>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
