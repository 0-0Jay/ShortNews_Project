<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/newsContentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/white"
    tools:context=".ui.news.NewsContentFragment">

    <include
        android:id="@+id/include"
        layout="@layout/fragment_nav_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="10dp"
        android:backgroundTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="10dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@+id/include"
            tools:layout_editor_absoluteX="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:backgroundTint="@color/white">

                <android.widget.Button
                    android:id="@+id/source"
                    android:layout_width="60dp"
                    android:layout_height="30dp"
                    android:background="@drawable/button_white"
                    android:text="출처"
                    app:layout_constraintBottom_toBottomOf="@+id/views"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/views"
                    tools:ignore="TouchTargetSizeCheck" />

                <ImageView
                    android:id="@+id/like"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/newsTitle"
                    app:layout_constraintTop_toBottomOf="@+id/imageSlide"
                    app:srcCompat="@drawable/default_like"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/likeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:backgroundTint="@color/white"
                    android:text="0"
                    app:layout_constraintBottom_toBottomOf="@+id/like"
                    app:layout_constraintStart_toEndOf="@+id/like"
                    app:layout_constraintTop_toTopOf="@+id/like" />

                <ImageView
                    android:id="@+id/dislike"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/white"
                    android:clickable="true"
                    app:layout_constraintStart_toEndOf="@+id/likeCount"
                    app:layout_constraintTop_toTopOf="@+id/like"
                    app:srcCompat="@drawable/default_dislike"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/dislikeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:backgroundTint="@color/white"
                    android:text="0"
                    app:layout_constraintBottom_toBottomOf="@+id/dislike"
                    app:layout_constraintStart_toEndOf="@+id/dislike"
                    app:layout_constraintTop_toTopOf="@+id/dislike" />

                <ImageView
                    android:id="@+id/reply"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/white"
                    app:layout_constraintStart_toEndOf="@+id/dislikeCount"
                    app:layout_constraintTop_toTopOf="@+id/dislike"
                    app:srcCompat="@drawable/reply" />

                <ImageView
                    android:id="@+id/views"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="@color/white"
                    app:layout_constraintStart_toEndOf="@+id/reply"
                    app:layout_constraintTop_toTopOf="@+id/reply"
                    app:srcCompat="@drawable/views" />

                <TextView
                    android:id="@+id/viewsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:backgroundTint="@color/white"
                    android:text="0"
                    app:layout_constraintBottom_toBottomOf="@+id/views"
                    app:layout_constraintStart_toEndOf="@+id/views"
                    app:layout_constraintTop_toTopOf="@+id/views" />

                <TextView
                    android:id="@+id/newsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="@color/white"
                    android:text="제목"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/newsThreeDots"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <ImageView
                    android:id="@+id/newsThreeDots"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ellipsis_vertical" />

                <android.widget.Button
                    android:id="@+id/newsReportButton"
                    android:layout_width="85dp"
                    android:layout_height="30dp"
                    android:background="@drawable/button_border_none"
                    android:backgroundTint="#FFFFFF"
                    android:text="신고하기"
                    android:textColor="#FF0000"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/newsThreeDots"
                    app:layout_constraintEnd_toEndOf="@+id/newsTitle"
                    app:layout_constraintTop_toTopOf="@+id/newsThreeDots"
                    tools:ignore="TouchTargetSizeCheck" />

                <View
                    android:id="@+id/view"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="5dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="10dp"
                    android:background="#57AEFF"
                    app:layout_constraintEnd_toStartOf="@+id/play"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/newsTitle"
                    tools:ignore="MissingConstraints" />

                <TextView
                    android:id="@+id/newsContent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="10dp"
                    android:backgroundTint="@color/white"
                    android:text="내용"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/newsTitle"
                    app:layout_constraintTop_toBottomOf="@+id/view" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/imageSlide"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="50dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/white"
                    app:layout_constraintEnd_toEndOf="@+id/newsContent"
                    app:layout_constraintStart_toStartOf="@+id/newsContent"
                    app:layout_constraintTop_toBottomOf="@+id/newsContent" />

                <ImageView
                    android:id="@+id/bookmarkBtn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    app:layout_constraintBottom_toBottomOf="@+id/views"
                    app:layout_constraintEnd_toStartOf="@+id/source"
                    app:layout_constraintTop_toTopOf="@+id/views"
                    app:srcCompat="@drawable/bookmark_no"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/sourceView"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="invisible"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="8dp"
                    app:layout_constraintBottom_toTopOf="@+id/source"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/RecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/play"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:clickable="true"
                    android:src="@drawable/play"
                    app:layout_constraintBottom_toBottomOf="@+id/view"
                    app:layout_constraintEnd_toEndOf="@+id/newsThreeDots"
                    app:layout_constraintTop_toTopOf="@+id/view"
                    tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

                <ImageView
                    android:id="@+id/share"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/share"
                    app:layout_constraintBottom_toBottomOf="@+id/bookmarkBtn"
                    app:layout_constraintEnd_toStartOf="@+id/bookmarkBtn"
                    app:layout_constraintTop_toTopOf="@+id/bookmarkBtn" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>